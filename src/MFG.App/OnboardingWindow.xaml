<Window x:Class="MFG.App.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Onboarding.WindowTitle}" Height="500" Width="640"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <TextBlock x:Name="StepTitleText" FontSize="22" FontWeight="SemiBold" />
    <Grid Grid.Row="1" Margin="0,22,0,22">
      <Grid x:Name="ComputerStep">
        <StackPanel>
          <TextBlock FontSize="16" TextWrapping="Wrap" Text="{DynamicResource Onboarding.Computer.Intro}" />
          <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" Text="{DynamicResource Onboarding.Computer.Description}" />
          <Button x:Name="PrepareComputerButton" Margin="0,22,0,0" HorizontalAlignment="Left" Padding="16,7" Click="PrepareComputer_Click" Content="{DynamicResource Onboarding.Computer.Action}" />
          <TextBlock x:Name="ComputerStatusText" Margin="0,14,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
      <Grid x:Name="KeyStep" Visibility="Collapsed">
        <StackPanel>
          <TextBlock FontSize="16" TextWrapping="Wrap" Text="{DynamicResource Onboarding.Key.Intro}" />
          <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Text="{DynamicResource Onboarding.Key.Description}" />
          <Button Margin="0,20,0,0" HorizontalAlignment="Left" Padding="14,6" Click="SelectKey_Click" Content="{DynamicResource Onboarding.Key.Action}" />
          <TextBlock x:Name="KeyStatusText" Margin="0,12,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
      <Grid x:Name="PairingStep" Visibility="Collapsed">
        <StackPanel>
          <TextBlock FontSize="16" TextWrapping="Wrap" Text="{DynamicResource Onboarding.Switch.Intro}" />
          <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" Text="{DynamicResource Onboarding.Switch.Description}" />
          <TextBlock x:Name="SwitchStatusText" Margin="0,16,0,0" TextWrapping="Wrap" />
          <Button Margin="0,14,0,0" HorizontalAlignment="Left" Padding="14,6" Click="CheckSwitch_Click" Content="{DynamicResource Onboarding.Switch.Action}" />
        </StackPanel>
      </Grid>
      <Grid x:Name="FinishStep" Visibility="Collapsed">
        <StackPanel>
          <TextBlock FontSize="16" TextWrapping="Wrap" Text="{DynamicResource Onboarding.Finish.Intro}" />
          <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" Text="{DynamicResource Onboarding.Finish.Description}" />
        </StackPanel>
      </Grid>
    </Grid>
    <DockPanel Grid.Row="2">
      <TextBlock x:Name="StepIndicatorText" VerticalAlignment="Center" Foreground="#666" />
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button x:Name="LaterButton" Margin="0,0,8,0" Padding="14,6" Click="Later_Click" Content="{DynamicResource Common.ConfigureLater}" />
        <Button x:Name="BackButton" Margin="0,0,8,0" Padding="14,6" Click="Back_Click" Content="{DynamicResource Common.Back}" />
        <Button x:Name="NextButton" Padding="14,6" Click="Next_Click" Content="{DynamicResource Common.Continue}" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
