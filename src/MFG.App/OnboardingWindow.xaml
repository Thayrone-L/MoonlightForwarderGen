<Window x:Class="MFG.App.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuração rápida" Height="500" Width="640"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <TextBlock x:Name="StepTitleText" FontSize="22" FontWeight="SemiBold" />
    <Grid Grid.Row="1" Margin="0,22,0,22">
      <Grid x:Name="ComputerStep">
        <StackPanel>
          <TextBlock FontSize="16" TextWrapping="Wrap" Text="Vamos preparar este computador automaticamente." />
          <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" Text="O MFG instala, configura e inicia o Sunshine. O Windows pode pedir uma confirmação de administrador." />
          <Button x:Name="PrepareComputerButton" Margin="0,22,0,0" HorizontalAlignment="Left" Padding="16,7" Click="PrepareComputer_Click" Content="Preparar computador" />
          <TextBlock x:Name="ComputerStatusText" Margin="0,14,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
      <Grid x:Name="KeyStep" Visibility="Collapsed">
        <StackPanel>
          <TextBlock FontSize="16" TextWrapping="Wrap" Text="Para criar atalhos instaláveis, selecione o arquivo prod.keys do seu próprio Switch." />
          <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Text="O MFG guarda a chave protegida neste usuário do Windows e nunca a copia para o cartão SD." />
          <Button Margin="0,20,0,0" HorizontalAlignment="Left" Padding="14,6" Click="SelectKey_Click" Content="Selecionar arquivo de chave" />
          <TextBlock x:Name="KeyStatusText" Margin="0,12,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
      <Grid x:Name="PairingStep" Visibility="Collapsed">
        <StackPanel>
          <TextBlock FontSize="16" TextWrapping="Wrap" Text="Agora conecte o Switch. Esta é a única etapa feita no console e só acontece uma vez." />
          <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" Text="1. Coloque o Moonlight-Switch no cartão SD e abra-o no Switch.&#x0a;2. Adicione este computador.&#x0a;3. Quando o PIN aparecer no Switch, confirme-o na interface do Sunshine.&#x0a;4. Feche o Moonlight e conecte o cartão SD neste computador." />
          <TextBlock x:Name="SwitchStatusText" Margin="0,16,0,0" TextWrapping="Wrap" />
          <Button Margin="0,14,0,0" HorizontalAlignment="Left" Padding="14,6" Click="CheckSwitch_Click" Content="Verificar cartão SD" />
        </StackPanel>
      </Grid>
      <Grid x:Name="FinishStep" Visibility="Collapsed">
        <StackPanel>
          <TextBlock FontSize="16" TextWrapping="Wrap" Text="Tudo pronto." />
          <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" Text="Agora escolha jogos na tela principal e clique em “Adicionar ao Switch”. Quando o cartão SD estiver conectado, os atalhos serão copiados automaticamente." />
        </StackPanel>
      </Grid>
    </Grid>
    <DockPanel Grid.Row="2">
      <TextBlock x:Name="StepIndicatorText" VerticalAlignment="Center" Foreground="#666" />
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button x:Name="LaterButton" Margin="0,0,8,0" Padding="14,6" Click="Later_Click" Content="Configurar depois" />
        <Button x:Name="BackButton" Margin="0,0,8,0" Padding="14,6" Click="Back_Click" Content="Voltar" />
        <Button x:Name="NextButton" Padding="14,6" Click="Next_Click" Content="Continuar" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
