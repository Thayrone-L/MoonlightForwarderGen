  <sys:String x:Key="Onboarding.WindowTitle">Configuração rápida</sys:String>
  <sys:String x:Key="Onboarding.Computer.Title">Preparar computador</sys:String>
  <sys:String x:Key="Onboarding.Computer.Intro">Vamos preparar este computador automaticamente.</sys:String>
  <sys:String x:Key="Onboarding.Computer.Description">O MFG instala, configura e inicia o Sunshine. O Windows pode pedir uma confirmação de administrador.</sys:String>
  <sys:String x:Key="Onboarding.Computer.Action">Preparar computador</sys:String>
  <sys:String x:Key="Onboarding.Computer.Preparing">Preparando o Sunshine...</sys:String>
  <sys:String x:Key="Onboarding.Computer.Ready">Computador pronto.</sys:String>
  <sys:String x:Key="Onboarding.Key.Title">Arquivo de chave</sys:String>
  <sys:String x:Key="Onboarding.Key.Intro">Para criar atalhos instaláveis, selecione o arquivo prod.keys do seu próprio Switch.</sys:String>
  <sys:String x:Key="Onboarding.Key.Description">O MFG guarda a chave protegida neste usuário do Windows e nunca a copia para o cartão SD.</sys:String>
  <sys:String x:Key="Onboarding.Key.Action">Selecionar arquivo de chave</sys:String>
  <sys:String x:Key="Onboarding.Key.Configured">Arquivo guardado com segurança neste computador.</sys:String>
  <sys:String x:Key="Onboarding.Key.Required">Selecione o arquivo para continuar.</sys:String>
  <sys:String x:Key="Onboarding.Key.Saving">Guardando arquivo com segurança...</sys:String>
  <sys:String x:Key="Onboarding.Key.Error">Não foi possível guardar o arquivo: {0}</sys:String>
  <sys:String x:Key="Onboarding.Key.Filter">Arquivos de chave (*.keys)|*.keys|Todos os arquivos (*.*)|*.*</sys:String>
  <sys:String x:Key="Onboarding.Switch.Title">Conectar Switch</sys:String>
  <sys:String x:Key="Onboarding.Switch.Intro">Agora conecte o Switch. Esta é a única etapa feita no console e só acontece uma vez.</sys:String>
  <sys:String x:Key="Onboarding.Switch.Description">1. Coloque o Moonlight-Switch no cartão SD e abra-o no Switch.&#x0a;2. Adicione este computador.&#x0a;3. Quando o PIN aparecer no Switch, confirme-o na interface do Sunshine.&#x0a;4. Feche o Moonlight e conecte o cartão SD neste computador.</sys:String>
  <sys:String x:Key="Onboarding.Switch.Action">Verificar cartão SD</sys:String>
  <sys:String x:Key="Onboarding.Switch.Ready">Cartão SD do Switch conectado e Moonlight-Switch configurado.</sys:String>
  <sys:String x:Key="Onboarding.Switch.Incomplete">Cartão SD encontrado, mas o Moonlight-Switch ainda não foi configurado e pareado. Conclua as etapas no console e tente novamente.</sys:String>
  <sys:String x:Key="Onboarding.Switch.Missing">Nenhum cartão SD do Switch foi encontrado. Conecte o cartão para continuar.</sys:String>
  <sys:String x:Key="Onboarding.Finish.Title">Tudo pronto</sys:String>
  <sys:String x:Key="Onboarding.Finish.Intro">Tudo pronto.</sys:String>
  <sys:String x:Key="Onboarding.Finish.Description">Agora escolha jogos na tela principal e clique em “Adicionar ao Switch”. Quando o cartão SD estiver conectado, os atalhos serão copiados automaticamente.</sys:String>
