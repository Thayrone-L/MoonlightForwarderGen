<Window x:Class="MFG.App.SwitchPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:MFG.App.Converters"
        Title="Preview do Switch" Width="1180" Height="720" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="#090C12">
  <Window.Resources>
    <converters:CoverPathToImageSourceConverter x:Key="CoverPathConverter" />
  </Window.Resources>
  <Grid>
    <Viewbox Stretch="Uniform" StretchDirection="Both">
      <Grid Width="1280" Height="720" Background="#10131A">
        <Grid.RowDefinitions>
          <RowDefinition Height="76" />
          <RowDefinition Height="590" />
          <RowDefinition Height="54" />
        </Grid.RowDefinitions>

        <Grid Background="#0C0F15">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Margin="46,0" VerticalAlignment="Center" FontSize="27" Text="Moonlight Forwarder" />
          <TextBlock Grid.Column="1" Margin="0,0,46,0" VerticalAlignment="Center"
                     Foreground="#55D6A0" FontSize="16" Text="Biblioteca pronta" />
        </Grid>

        <Grid Grid.Row="1" Margin="48,22">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="22" />
            <ColumnDefinition Width="420" />
          </Grid.ColumnDefinitions>

          <Border Background="#191E28" CornerRadius="18" Padding="24">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <TextBlock FontSize="29" FontWeight="SemiBold" Text="Seus jogos" />
              <TextBlock Grid.Row="1" Margin="0,5,0,0" Foreground="#9CA8BA" FontSize="17"
                         Text="Escolha um jogo. O resto acontece sozinho." />
              <ListBox x:Name="PreviewGamesList" Grid.Row="3" ItemsSource="{Binding Games}"
                       Background="Transparent" BorderThickness="0"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <Border x:Name="Row" Height="66" Padding="8,7,14,7" Background="#242B38" CornerRadius="11">
                            <ContentPresenter />
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="Row" Property="Background" Value="#30284F" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                              <Setter TargetName="Row" Property="Background" Value="#30284F" />
                              <Setter TargetName="Row" Property="BorderBrush" Value="#7C5CFC" />
                              <Setter TargetName="Row" Property="BorderThickness" Value="3" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="13" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Border Width="52" Height="52" Background="#11151C" CornerRadius="6" ClipToBounds="True">
                        <Image Source="{Binding CoverPath, Converter={StaticResource CoverPathConverter}}" Stretch="UniformToFill" />
                      </Border>
                      <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock FontSize="19" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,2,0,0" FontSize="14" Foreground="#55D6A0" Text="Pronto" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock x:Name="EmptyLibraryText" Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="#9CA8BA" FontSize="20" Text="Nenhum atalho preparado ainda." Visibility="Collapsed" />
            </Grid>
          </Border>

          <Border Grid.Column="2" Background="#191E28" CornerRadius="18" Padding="34">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
              <Border Width="180" Height="180" Background="#11151C" CornerRadius="12" ClipToBounds="True">
                <Image Source="{Binding SelectedItem.CoverPath, ElementName=PreviewGamesList, Converter={StaticResource CoverPathConverter}}"
                       Stretch="UniformToFill" />
              </Border>
              <TextBlock Width="340" Margin="0,18,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                         FontSize="29" FontWeight="SemiBold" TextWrapping="Wrap"
                         Text="{Binding SelectedItem.Name, ElementName=PreviewGamesList, FallbackValue=Tudo pronto por aqui}" />
              <TextBlock Width="340" Margin="0,12,0,26" HorizontalAlignment="Center" TextAlignment="Center"
                         Foreground="#9CA8BA" FontSize="18" TextWrapping="Wrap"
                         Text="Pronto para virar um atalho no seu Switch." />
              <Border Width="340" Height="58" Background="#7C5CFC" CornerRadius="8">
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"
                           Text="Adicionar ao Switch" />
              </Border>
            </StackPanel>
          </Border>
        </Grid>

        <Grid Grid.Row="2" Background="#0C0F15">
          <TextBlock Margin="46,0" VerticalAlignment="Center" Foreground="#9CA8BA" FontSize="15" Text="A  Selecionar" />
          <TextBlock Margin="0,0,46,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                     Foreground="#9CA8BA" FontSize="15" Text="X  Atualizar     +  Sair" />
        </Grid>
      </Grid>
    </Viewbox>
    <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,12,0,0" Padding="12,6"
            Background="#E6151A23" CornerRadius="12">
      <TextBlock Foreground="#9CA8BA" Text="Prévia proporcional de 1280 × 720" />
    </Border>
  </Grid>
</Window>
