<Window x:Class="MFG.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Moonlight Forwarder Generator" Height="500" Width="560"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="16" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="16" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="16" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock FontSize="20" FontWeight="SemiBold" Text="MFG — Biblioteca local" />
      <TextBlock x:Name="SunshineStatusText" Margin="0,8,0,0" TextWrapping="Wrap" />
      <Button x:Name="InstallSunshineButton" Margin="0,8,0,0" HorizontalAlignment="Left" Padding="12,5" Click="InstallSunshine_Click" Content="Instalar Sunshine" Visibility="Collapsed" />
    </StackPanel>
    <TextBlock Grid.Row="2" Margin="0,12,0,6" FontWeight="SemiBold" Text="Cadastrar jogo" />
    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="110" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="86" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="8" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="8" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock VerticalAlignment="Center" Text="ID do jogo" />
      <TextBox x:Name="RegisterGameIdTextBox" Grid.Column="1" Grid.ColumnSpan="2" />
      <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Executável" />
      <TextBox x:Name="ExecutablePathTextBox" Grid.Row="2" Grid.Column="1" />
      <Button Grid.Row="2" Grid.Column="2" Margin="8,0,0,0" Click="BrowseExecutable_Click" Content="Procurar" />
      <Button Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Height="32" Click="SaveGame_Click" Content="Salvar jogo" />
    </Grid>
    <TextBlock Grid.Row="6" Margin="0,12,0,6" FontWeight="SemiBold" Text="Executar jogo cadastrado" />
    <Grid Grid.Row="7">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="110" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock VerticalAlignment="Center" Text="ID do jogo" />
      <TextBox x:Name="LaunchGameIdTextBox" Grid.Column="1" />
      <Button Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Height="32" Click="LaunchGame_Click" Content="Executar" />
    </Grid>
    <TextBlock x:Name="StatusText" Grid.Row="8" Margin="0,16,0,0" TextWrapping="Wrap" Text="Inicie o MFG.Agent antes de enviar um comando." />
  </Grid>
</Window>
