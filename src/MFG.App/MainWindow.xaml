<Window x:Class="MFG.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:MFG.App.Converters"
        Title="Moonlight Forwarder" Height="760" Width="1040" MinHeight="620" MinWidth="840"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
  <Grid>
    <Grid.Resources>
      <converters:CoverPathToImageSourceConverter x:Key="CoverPathConverter" />
    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Menu>
      <MenuItem Header="_Biblioteca">
        <MenuItem Header="Procurar jogos novamente" Click="RefreshInstalledGames_Click" />
        <MenuItem Header="Verificar atalhos" Click="RunHealthCheck_Click" />
      </MenuItem>
      <MenuItem Header="_Configurações">
        <MenuItem Header="Configuração inicial" Click="OpenSetup_Click" />
        <Separator />
        <MenuItem Header="Abrir pasta de logs" Click="OpenLogs_Click" />
      </MenuItem>
    </Menu>

    <Grid Grid.Row="1" Margin="34,28,34,26">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="24" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock FontSize="30" FontWeight="Bold" Text="Seus jogos no Switch" />
          <TextBlock Margin="0,6,0,0" Foreground="{StaticResource MutedTextBrush}"
                     FontSize="14" Text="Escolha um jogo. O resto acontece sozinho." />
        </StackPanel>
        <Border Grid.Column="1" Width="360" VerticalAlignment="Center" Padding="12,7"
                Background="#172B27" BorderBrush="#285044" BorderThickness="1" CornerRadius="14">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                     Fill="{StaticResource SuccessBrush}" />
            <TextBlock x:Name="ReadinessText" MaxWidth="360" Foreground="#BDEBD9"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
          </StackPanel>
        </Border>
      </Grid>

      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.35*" />
          <ColumnDefinition Width="22" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="14" Padding="10">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="10,8,10,12">
              <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                         Foreground="{StaticResource MutedTextBrush}" Text="Steam e Epic" />
              <TextBlock FontSize="17" FontWeight="SemiBold" Text="Biblioteca" />
            </DockPanel>
            <ListBox x:Name="InstalledGamesList" Grid.Row="1"
                     SelectionChanged="InstalledGamesList_SelectionChanged"
                     Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="Margin" Value="0,2" />
                  <Setter Property="Background" Value="Transparent" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                CornerRadius="9" Padding="8">
                          <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="#242B38" />
                          </Trigger>
                          <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="#30284F" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="70" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="58" Height="58" Background="#11151C" CornerRadius="8" ClipToBounds="True">
                      <Image Source="{Binding CoverPath, Converter={StaticResource CoverPathConverter}}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" Text="{Binding Source}" />
                      <ComboBox Margin="0,7,0,0" ItemsSource="{Binding Candidates}" DisplayMemberPath="ExecutablePath"
                                SelectionChanged="AlternativeExecutable_SelectionChanged">
                        <ComboBox.Style>
                          <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding HasAlternatives}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </ComboBox.Style>
                      </ComboBox>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Border x:Name="GamesLoadingOverlay" Grid.Row="1"
                    Background="#D9191E28" CornerRadius="9" Visibility="Collapsed">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Width="42" Height="42" HorizontalAlignment="Center">
                  <Ellipse Stroke="#343B49" StrokeThickness="4" />
                  <Ellipse Stroke="{StaticResource AccentBrush}" StrokeThickness="4"
                           StrokeDashArray="5,14" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                           RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                      <RotateTransform />
                    </Ellipse.RenderTransform>
                    <Ellipse.Triggers>
                      <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                          <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                             From="0" To="360" Duration="0:0:0.85" />
                          </Storyboard>
                        </BeginStoryboard>
                      </EventTrigger>
                    </Ellipse.Triggers>
                  </Ellipse>
                </Grid>
                <TextBlock Margin="0,14,0,0" Foreground="{StaticResource MutedTextBrush}"
                           Text="Atualizando sua biblioteca…" />
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="14" Padding="24">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel VerticalAlignment="Center">
              <Border Width="180" Height="180" HorizontalAlignment="Center" Background="#11151C"
                      CornerRadius="18" ClipToBounds="True">
                <Image Source="{Binding SelectedItem.CoverPath, ElementName=InstalledGamesList, Converter={StaticResource CoverPathConverter}}"
                       Stretch="UniformToFill" />
              </Border>
              <TextBlock Margin="0,20,0,0" HorizontalAlignment="Center" FontSize="22" FontWeight="Bold"
                         Text="{Binding SelectedItem.Name, ElementName=InstalledGamesList, FallbackValue=Escolha um jogo}"
                         TextAlignment="Center" TextWrapping="Wrap" />
              <TextBlock x:Name="SelectionHintText" Margin="0,8,0,0" HorizontalAlignment="Center"
                         Foreground="{StaticResource MutedTextBrush}" Text="Pronto para virar um atalho no seu Switch."
                         TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="1">
              <Button Height="48" Style="{StaticResource PrimaryButton}" Click="PrepareGame_Click"
                      Content="Adicionar ao Switch" />
              <Expander Margin="0,12,0,0" Foreground="{StaticResource MutedTextBrush}"
                        Header="Não encontrou seu jogo?">
                <StackPanel Margin="0,12,0,0">
                  <TextBlock Margin="0,0,0,5" Foreground="{StaticResource MutedTextBrush}" Text="Nome" />
                  <TextBox x:Name="GameNameTextBox" />
                  <TextBlock Margin="0,10,0,5" Foreground="{StaticResource MutedTextBrush}" Text="Executável" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ExecutablePathTextBox" />
                    <Button Grid.Column="1" Margin="8,0,0,0" Padding="12,7"
                            Click="BrowseExecutable_Click" Content="Escolher" />
                  </Grid>
                </StackPanel>
              </Expander>
              <Button Margin="0,10,0,0" Padding="8" HorizontalAlignment="Center"
                      Background="Transparent" BorderThickness="0" Foreground="#D4868C"
                      Click="RemoveGame_Click" Content="Remover este atalho" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <Border Grid.Row="3" Margin="0,18,0,0" Padding="14,10" Background="#151A23" CornerRadius="8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="180" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"
                     Text="Preparando sua biblioteca…" TextWrapping="Wrap" />
          <ProgressBar x:Name="SearchProgress" Grid.Column="1" Height="5" Margin="16,0,0,0"
                       VerticalAlignment="Center" Visibility="Collapsed" IsIndeterminate="True"
                       Foreground="{StaticResource AccentBrush}" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
