<Window x:Class="MFG.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:MFG.App.Converters"
        Title="Moonlight Forwarder" Height="760" Width="1040" MinHeight="620" MinWidth="840"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
  <Grid>
    <Grid.Resources>
      <converters:CoverPathToImageSourceConverter x:Key="CoverPathConverter" />
      <Style x:Key="TopBarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="8"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Chrome" Property="Background" Value="#242B38" />
                  <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Chrome" Property="Background" Value="#30284F" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="52" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Menu Visibility="Collapsed">
      <MenuItem Header="{DynamicResource Main.Library}">
        <MenuItem Header="{DynamicResource Main.SwitchPreview}" Click="OpenSwitchPreview_Click" />
        <Separator />
        <MenuItem Header="{DynamicResource Main.SearchAgain}" Click="RefreshInstalledGames_Click" />
        <MenuItem Header="{DynamicResource Main.CheckShortcuts}" Click="RunHealthCheck_Click" />
      </MenuItem>
      <MenuItem Header="{DynamicResource Main.Settings}">
        <MenuItem Header="{DynamicResource Main.InitialSetup}" Click="OpenSetup_Click" />
        <Separator />
        <MenuItem Header="{DynamicResource Main.OpenLogs}" Click="OpenLogs_Click" />
      </MenuItem>
    </Menu>

    <Border Background="#0C0F15" BorderBrush="#202633" BorderThickness="0,0,0,1">
      <Grid Margin="22,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Height="34" Padding="13,0" Background="#30284F" CornerRadius="8">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="3" />
              </Grid.RowDefinitions>
              <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="{DynamicResource Main.Library}" />
              <Border Grid.Row="1" Width="24" Height="3" Background="{StaticResource AccentBrush}" CornerRadius="2" />
            </Grid>
          </Border>
          <Button Margin="6,0,0,0" Style="{StaticResource TopBarButton}"
                  Click="OpenSwitchPreview_Click" Content="{DynamicResource Main.SwitchPreview}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource TopBarButton}" Click="UpdateSwitch_Click" Content="{DynamicResource Main.Update}" />
          <Border Width="1" Height="20" Margin="8,0" Background="#303847" />
          <Button Style="{StaticResource TopBarButton}" Click="OpenSetup_Click" Content="{DynamicResource Main.Settings}" />
          <Button Width="38" Padding="0" Style="{StaticResource TopBarButton}" Click="OpenLogs_Click"
                  Content="•••" ToolTip="{DynamicResource Main.OpenLogs}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="34,28,34,26">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="24" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock FontSize="30" FontWeight="Bold" Text="{DynamicResource Main.Hero.Title}" TextWrapping="Wrap" />
          <TextBlock Margin="0,6,0,0" Foreground="{StaticResource MutedTextBrush}"
                     FontSize="14" Text="{DynamicResource Main.Hero.Subtitle}" TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Column="1" MaxWidth="520" Margin="18,0,0,0" VerticalAlignment="Center" Padding="12,7"
                Background="#172B27" BorderBrush="#285044" BorderThickness="1" CornerRadius="14">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                     Fill="{StaticResource SuccessBrush}" />
            <TextBlock x:Name="ReadinessText" MaxWidth="480" Foreground="#BDEBD9"
                       TextWrapping="Wrap" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
          </StackPanel>
        </Border>
      </Grid>

      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.35*" />
          <ColumnDefinition Width="22" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="14" Padding="10">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="10,8,10,12">
              <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                         Foreground="{StaticResource MutedTextBrush}" Text="{DynamicResource Main.Library.Sources}" />
              <TextBlock FontSize="17" FontWeight="SemiBold" Text="{DynamicResource Main.Library}" />
            </DockPanel>
            <ListBox x:Name="InstalledGamesList" Grid.Row="1" IsEnabled="False"
                     SelectionChanged="InstalledGamesList_SelectionChanged"
                     Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="Margin" Value="0,2" />
                  <Setter Property="Background" Value="Transparent" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                CornerRadius="9" Padding="8">
                          <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="#242B38" />
                          </Trigger>
                          <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="#30284F" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="70" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="58" Height="58" Background="#11151C" CornerRadius="8" ClipToBounds="True">
                      <Image Source="{Binding CoverPath, Converter={StaticResource CoverPathConverter}}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" Text="{Binding Source}" />
                      <ComboBox Margin="0,7,0,0" ItemsSource="{Binding Candidates}" DisplayMemberPath="ExecutablePath"
                                SelectionChanged="AlternativeExecutable_SelectionChanged">
                        <ComboBox.Style>
                          <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding HasAlternatives}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </ComboBox.Style>
                      </ComboBox>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Border x:Name="GamesLoadingOverlay" Grid.Row="1"
                    Background="#F2191E28" CornerRadius="9" Visibility="Visible">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Width="42" Height="42" HorizontalAlignment="Center">
                  <Ellipse Stroke="#343B49" StrokeThickness="4" />
                  <Ellipse Stroke="{StaticResource AccentBrush}" StrokeThickness="4"
                           StrokeDashArray="5,14" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                           RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                      <RotateTransform />
                    </Ellipse.RenderTransform>
                    <Ellipse.Triggers>
                      <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                          <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                             From="0" To="360" Duration="0:0:0.85" />
                          </Storyboard>
                        </BeginStoryboard>
                      </EventTrigger>
                    </Ellipse.Triggers>
                  </Ellipse>
                </Grid>
                <TextBlock Margin="0,14,0,0" Foreground="{StaticResource MutedTextBrush}"
                           Text="{DynamicResource Main.Library.Loading}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="14" Padding="24">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel VerticalAlignment="Center">
              <Border Width="180" Height="180" HorizontalAlignment="Center" Background="#11151C"
                      CornerRadius="18" ClipToBounds="True">
                <Image Source="{Binding SelectedItem.CoverPath, ElementName=InstalledGamesList, Converter={StaticResource CoverPathConverter}}"
                       Stretch="UniformToFill" />
              </Border>
              <TextBlock Margin="0,20,0,0" HorizontalAlignment="Center" FontSize="22" FontWeight="Bold"
                         Text="{Binding SelectedItem.Name, ElementName=InstalledGamesList, FallbackValue={DynamicResource Main.SelectGame}}"
                         TextAlignment="Center" TextWrapping="Wrap" />
              <TextBlock x:Name="SelectionHintText" Margin="0,8,0,0" HorizontalAlignment="Center"
                         Foreground="{StaticResource MutedTextBrush}" Text="{DynamicResource Main.SelectionHint}"
                         TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="1">
              <Border x:Name="ShortcutCreatedBanner" Margin="0,0,0,12" Padding="14,12"
                      Background="#172B27" BorderBrush="#34705C" BorderThickness="1"
                      CornerRadius="10" Visibility="Collapsed">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Width="24" Height="24" VerticalAlignment="Top" Background="{StaticResource SuccessBrush}"
                          CornerRadius="12">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#10221C"
                               FontSize="15" FontWeight="Bold" Text="✓" />
                  </Border>
                  <StackPanel Grid.Column="1">
                    <TextBlock x:Name="ShortcutCreatedTitle" Foreground="#BDEBD9" FontWeight="SemiBold"
                               Text="{DynamicResource Main.ShortcutCreated}" TextWrapping="Wrap" />
                    <TextBlock x:Name="ShortcutCreatedDetail" Margin="0,3,0,0" Foreground="#8FD0B8"
                               FontSize="12" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </Border>
              <Button x:Name="PrepareGameButton" Height="48" Style="{StaticResource PrimaryButton}" Click="PrepareGame_Click"
                      Content="{DynamicResource Main.AddToSwitch}" />
              <Expander Margin="0,12,0,0" Foreground="{StaticResource MutedTextBrush}"
                        Header="{DynamicResource Main.ManualGame}">
                <StackPanel Margin="0,12,0,0">
                  <TextBlock Margin="0,0,0,5" Foreground="{StaticResource MutedTextBrush}" Text="{DynamicResource Main.Name}" />
                  <TextBox x:Name="GameNameTextBox" />
                  <TextBlock Margin="0,10,0,5" Foreground="{StaticResource MutedTextBrush}" Text="{DynamicResource Main.Executable}" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ExecutablePathTextBox" />
                    <Button Grid.Column="1" Margin="8,0,0,0" Padding="12,7"
                            Click="BrowseExecutable_Click" Content="{DynamicResource Main.Choose}" />
                  </Grid>
                </StackPanel>
              </Expander>
              <Button Margin="0,10,0,0" Padding="8" HorizontalAlignment="Center"
                      Background="Transparent" BorderThickness="0" Foreground="#D4868C"
                      Click="RemoveGame_Click" Content="{DynamicResource Main.RemoveShortcut}" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <Border Grid.Row="3" Margin="0,18,0,0" Padding="14,10" Background="#151A23" CornerRadius="8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="180" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"
                     Text="{DynamicResource Main.Library.Preparing}" TextWrapping="Wrap" />
          <ProgressBar x:Name="SearchProgress" Grid.Column="1" Height="5" Margin="16,0,0,0"
                       VerticalAlignment="Center" Visibility="Collapsed" IsIndeterminate="True"
                       Foreground="{StaticResource AccentBrush}" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
